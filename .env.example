# Supabase Configuration
# Replace these placeholder values with your project credentials from the Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / public)

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key-placeholder

# Netlify Server-Side Configuration (configured in Netlify Site settings -> Environment variables)
# Never expose the service role key to the browser client.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
